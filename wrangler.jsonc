// Cloudflare Worker that serves the prerendered site in build/ as static assets.
// Deployed only by the GitHub workflows (see `pnpm release`).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fbcb",
	"compatibility_date": "2026-11-01",
	"assets": { "directory": "./build" },
	// Production URLs. fbcb.tpetrov.dev was the temporary domain and stays so old links keep working.
	"routes": [
		{ "pattern": "bellflowerbaptist.church", "custom_domain": true },
		{ "pattern": "www.bellflowerbaptist.church", "custom_domain": true },
		{ "pattern": "fbcb.tpetrov.dev", "custom_domain": true }
	],
	"preview_urls": true
}
